APP_ENV=development
# Unique application secret; production requires 32+ random characters.
APP_SECRET=replace-with-32+-random-characters
# Use two different 32+ character token secrets in production.
ACCESS_TOKEN_SECRET=replace-with-32+-random-characters
REFRESH_TOKEN_SECRET=replace-with-32+-random-characters
# Async SQLAlchemy URL for the control-plane PostgreSQL database.
CONTROL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@control-db:5432/platform_control_db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_DSN_ENCRYPTION_KEY=replace-with-a-fernet-key
# Production requires s3; local is development/test only.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
MAX_XRAY_BYTES=15728640
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
MAX_TENANT_ENGINES=100
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=127.0.0.1
AI_PROVIDER=mock
AI_MODEL_ARTIFACT_PATH=model_artifacts
AI_CONFIG_PATH=configs/ai/opg_v1.yaml
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
ALLOW_PRODUCTION_MOCK_AI=false

# WhatsApp/Baileys is embedded in the DENTAI web container by default, matching the scrap repo.
# No WHATSAPP_SERVICE_URL or WHATSAPP_SERVICE_TOKEN is needed for the default loopback mode.
WHATSAPP_EMBEDDED_SERVICE=true
WHATSAPP_SERVICE_PORT=3001
WHATSAPP_SESSION_DIR=/app/data/whatsapp_sessions
WHATSAPP_SERVICE_URL=
WHATSAPP_SERVICE_TOKEN=
WHATSAPP_SERVICE_TIMEOUT_SECONDS=20
WHATSAPP_FOLLOWUP_TIMEZONE=Asia/Yerevan
WHATSAPP_REMINDER_LEAD_DAYS=7
WHATSAPP_SEND_HOUR=10
WHATSAPP_WORKER_POLL_SECONDS=5
WHATSAPP_CONNECTION_RETRY_SECONDS=60
WHATSAPP_CLAIM_TIMEOUT_SECONDS=300
WHATSAPP_MAX_ATTEMPTS=5

# Patient Radar operational worker. Run as a dedicated service with:
# python -m app.radar.worker
RADAR_WORKER_POLL_SECONDS=5
RADAR_CLAIM_SECONDS=180
RADAR_HTTP_TIMEOUT_SECONDS=20
RADAR_HTTP_MAX_BYTES=2097152
RADAR_MAX_ITEMS_PER_POLL=300
RADAR_USER_AGENT=DENTAI-Patient-Radar/1.0 (+read-only intelligence)
# Uses GROQ_API_KEY/GROQ_MODEL for batched multilingual semantic refinement.
# If disabled or unavailable, deterministic multilingual heuristics remain active.
RADAR_LLM_ENABLED=true
RADAR_LLM_BATCH_SIZE=32
# Optional authorized-session collector for Instagram/Facebook and protected sources.
# The collector keeps platform sessions outside the clinical API/database.
RADAR_COLLECTOR_URL=
RADAR_COLLECTOR_TOKEN=
RADAR_COLLECTOR_TIMEOUT_SECONDS=30
